# Copy to .env and fill in real values. Never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
APP_ENV=development
DATABASE_URL=sqlite:///./data/securedoc.db
AUDIT_LOG_PATH=./data/audit.log
# Used to derive the Fernet key for the local PII token vault.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_VAULT_KEY=
# API key required on protected endpoints (sent as the X-API-Key header).
# Generate with: openssl rand -hex 32
SECUREDOC_API_KEY=
# Guard risk score (0-100) at or above which a request is blocked.
INJECTION_BLOCK_THRESHOLD=40
# URL of the Java document-validation service (must be reachable to accept uploads).
JAVA_VALIDATOR_URL=http://localhost:8080
# Comma-separated browser origins allowed by CORS. In production, set this to
# the dashboard origin only (e.g. https://your-project.vercel.app).
ALLOWED_CORS_ORIGINS=http://localhost:5173
# Maximum upload size in decimal megabytes (1 MB = 1,000,000 bytes).
MAX_UPLOAD_SIZE_MB=5
# Maximum length of a text document submitted to /api/process-document.
MAX_TEXT_CHARS=20000
# Per-client-IP request window on the document endpoints (sliding, in-memory).
RATE_LIMIT_PER_MINUTE=20
