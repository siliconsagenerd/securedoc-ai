# SecureDoc AI — production configuration template.
# Copy to .env, fill in real values, keep it out of version control.
#
# Generate strong keys with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# --- REQUIRED ---

# Fernet encryption key for PII placeholders (must be >= 32 bytes, URL-safe).
TOKEN_VAULT_KEY=

# Shared API key: nginx injects this request header, the backend validates it.
SECUREDOC_API_KEY=

# Public hostname for the dashboard, e.g. https://securedoc.example.com
PUBLIC_ORIGIN=

# Browser origin(s) allowed by CORS, comma-separated. Set to the Vercel
# dashboard origin only (e.g. https://your-project.vercel.app).
ALLOWED_CORS_ORIGINS=

# --- OPTIONAL / defaults ---

# Google Gemini key. When empty, the API returns sanitized text and
# "LLM provider is not configured" instead of calling a model.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

MAX_UPLOAD_SIZE_MB=5
RATE_LIMIT_PER_MINUTE=20

# Directory on the host that holds server.crt and server.key (TLS).
CERTS_DIR=./certs