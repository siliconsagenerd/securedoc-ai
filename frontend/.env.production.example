# SecureDoc AI — Vercel environment template for the frontend project.
#
# The SPA holds NO secrets: it calls the same-origin /api/* routes, which the
# serverless proxy in api/[[...path]].py forwards to the Railway backend and
# authenticates with X-API-Key server-side. Set the two variables below in the
# Vercel project (Project → Settings → Environment Variables). Both are
# server-only — do NOT prefix them with VITE_, or they would be bundled into
# the browser build.

# Shared key the proxy injects as X-API-Key. Must equal the backend's
# SECUREDOC_API_KEY. Never exposed to the browser.
SECUREDOC_API_KEY=

# Public base URL of the Railway FastAPI service (no trailing slash),
# e.g. https://securedoc-backend.up.railway.app
BACKEND_URL=
