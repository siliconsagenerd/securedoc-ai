# Local development only. The frontend no longer holds an API key.
#
# The Vite dev server proxies /api and /health to the backend and injects the
# X-API-Key header server-side. Export the same value the backend uses:
#
#   export SECUREDOC_API_KEY="$(openssl rand -hex 32)"
#
# (Set it in your shell, not in this file, so it is never bundled.)
